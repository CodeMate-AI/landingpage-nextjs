# Public Contact API Endpoint
NEXT_PUBLIC_CONTACT_API_URL=https://your-api-domain.com/landing/contact

# Custom asset upload endpoint for community media and CMS assets (Images <= 5MB, Videos <= 50MB)
CUSTOM_UPLOAD_ENDPOINT=https://backend.codemate.ai/upload/image

# MongoDB Connection String (Run 'npx tsx scripts/setup-db.ts' to create database indexes)
MONGODB_URI=mongodb+srv://<username>:<password>@dev.dpi8u9w.mongodb.net/codemate_blog?retryWrites=true&w=majority
MONGODB_DB_NAME=codemate_blog

# Docs database (same cluster; run 'npx tsx scripts/setup-docs-db.ts' to create indexes)
MONGODB_DOCS_DB_NAME=codemate_docs

# JWT Session Secret (minimum 32 characters for security)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters

# Admin Credentials
# NOTE: After setting or updating ADMIN_EMAIL and ADMIN_PASSWORD,
# run 'npx tsx scripts/seed-admin.ts' to hash and sync credentials into MongoDB.
ADMIN_EMAIL=admin@codemate.ai
ADMIN_PASSWORD=your-secure-password

# Docs Ask AI (server only). BASE_URL is an OpenAI-compatible base; the SDK appends /chat/completions.
# TOKEN is sent as the `authorization` header (include "Bearer "), API_KEY as the `api-key` header.
DOCS_AI_BASE_URL=https://your-ai-gateway.example.com/v2
DOCS_AI_TOKEN=Bearer your-token
DOCS_AI_API_KEY=your-api-key
DOCS_AI_MODEL=bodh-b0
