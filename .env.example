# Public Contact API Endpoint
NEXT_PUBLIC_CONTACT_API_URL=https://your-api-domain.com/landing/contact

# MongoDB Connection String (Run 'npx tsx scripts/setup-db.ts' to create database indexes)
MONGODB_URI=mongodb+srv://<username>:<password>@dev.dpi8u9w.mongodb.net/codemate_blog?retryWrites=true&w=majority

# JWT Session Secret (minimum 32 characters for security)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters

# Admin Credentials
# NOTE: After setting or updating ADMIN_EMAIL and ADMIN_PASSWORD,
# run 'npx tsx scripts/seed-admin.ts' to hash and sync credentials into MongoDB.
ADMIN_EMAIL=admin@codemate.ai
ADMIN_PASSWORD=your-secure-password

# Media Upload Endpoint for CMS Editor (Images <= 5MB, Videos <= 50MB)
CUSTOM_UPLOAD_ENDPOINT=https://your-api-domain.com/upload/image
